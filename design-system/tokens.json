{
  "name": "Equinox Quiet Room",
  "version": "1.0.0",
  "brand": {
    "productName": "Equinox Audio Visuals",
    "tagline": "Event production with character.",
    "ctaPrimary": "Start a project",
    "ctaPrimaryArrow": "Start a project →",
    "founded": "2023",
    "locale": "Manchester, VT"
  },
  "color": {
    "ink": "#121212",
    "slate": "#2A2A2A",
    "bone": "#F4EFE6",
    "linen": "#E6DFD1",
    "ember": "#C2582A",
    "brass": "#B8985A",
    "scope": "#9FE870"
  },
  "colorRoles": {
    "canvas": "bone",
    "text": "ink",
    "primaryFill": "ink",
    "interactive": "ember",
    "hairline": "brass",
    "liveReserved": "scope"
  },
  "typography": {
    "heading": "Newsreader",
    "body": "Inter Tight",
    "mono": "JetBrains Mono",
    "deprecatedDisplay": "Fraunces",
    "scale": {
      "1": "0.8125rem",
      "2": "1rem",
      "3": "1.125rem",
      "4": "1.5rem",
      "5": "2.25rem",
      "6": "3.5rem",
      "7": "clamp(3.5rem, 7vw, 6rem)"
    },
    "measure": "62ch"
  },
  "space": {
    "1": 8,
    "2": 16,
    "3": 24,
    "4": 40,
    "5": 64,
    "6": 96,
    "7": 160,
    "8": 240,
    "afterHeroTopRem": 6,
    "unit": "px"
  },
  "spaceRoles": {
    "micro": ["1", "2", "3"],
    "component": ["4", "5"],
    "sectionStandard": "7",
    "maxBreath": "8",
    "note": "Max Breath is section padding for signature moments only, not default margins."
  },
  "layout": {
    "containerV2": 1240,
    "gutter": 40,
    "radius1": 4
  },
  "motion": {
    "viewTransitionMs": 350,
    "dur1Ms": 160,
    "dur2Ms": 320,
    "dur3Ms": 640,
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "logo": {
    "navAsset": "assets/logo-wordmark.png",
    "navTreatment": "ink-on-bone",
    "navHeightPxDesktop": 28,
    "navHeightPxMobile": 22,
    "ogAsset": "assets/logo.png",
    "footer": "text-only",
    "stackedMedallion": "rejected"
  },
  "voice": {
    "keep": [
      "Character",
      "Hospitality mindset",
      "Invisible",
      "The best AV is invisible",
      "Cool kids, nice guys",
      "Hands on the console",
      "Event production with character"
    ],
    "kill": [
      "Crystal-clear",
      "Transform",
      "Discover",
      "Seamless",
      "Unforgettable",
      "Get a Quote",
      "Elevate",
      "Wedding Couple",
      "Event Partner"
    ]
  },
  "cssSources": {
    "tokens": "stable-header.css",
    "components": "design-system-v2.css",
    "scope": "body.v2"
  }
}
